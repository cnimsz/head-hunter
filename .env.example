# Cloudflare Turnstile site key. Public by design — embedded in the client bundle.
# For local dev / testing, use Cloudflare's always-pass test key:
#   1x00000000000000000000AA  (always passes)
# For production, generate real keys at https://dash.cloudflare.com/?to=/:account/turnstile
# and set the matching TURNSTILE_SECRET_KEY as a Supabase secret on the edge function.
VITE_TURNSTILE_SITE_KEY=

# Supabase project URL + anon key. Used for the cv-gap-analysis and jobsearch
# skills (Supabase Auth via magic link + per-user RLS on history tables).
# Find these at https://supabase.com/dashboard/project/<ref>/settings/api
# Both are safe to expose in the client bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
